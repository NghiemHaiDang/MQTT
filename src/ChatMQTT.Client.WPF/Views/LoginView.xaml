<UserControl x:Class="ChatMQTT.Client.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Branding -->
        <Border Grid.Column="0" Background="#A50034">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- LG Logo Style -->
                    <Viewbox Width="150" Height="150" Margin="0,0,0,40">
                        <Canvas Width="100" Height="100">
                            <Ellipse Width="100" Height="100" Fill="White"/>
                            <Ellipse Canvas.Left="15" Canvas.Top="15" Width="70" Height="70" Fill="#A50034"/>
                            <Path Data="M 30,50 L 55,50 L 55,70 L 70,70" Stroke="White" StrokeThickness="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="58" Canvas.Top="58" Width="15" Height="15" Fill="White"/>
                        </Canvas>
                    </Viewbox>

                    <TextBlock Text="VNB Messenger" FontSize="42" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Connect. Communicate. Collaborate." FontSize="16"
                               Foreground="#FFB3C7" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right Panel - Login/Register Forms -->
        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Selector -->
            <Border Grid.Row="0" Background="#F8F8F8" Padding="60,40,60,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="SIGN IN"
                            Command="{Binding ShowLoginCommand}"
                            FontSize="16" FontWeight="Bold" Height="50"
                            BorderThickness="0,0,0,3" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoginView}" Value="True">
                                        <Setter Property="Foreground" Value="#A50034"/>
                                        <Setter Property="BorderBrush" Value="#A50034"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="1" Content="SIGN UP"
                            Command="{Binding ShowRegisterCommand}"
                            FontSize="16" FontWeight="Bold" Height="50"
                            BorderThickness="0,0,0,3" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#999999"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoginView}" Value="False">
                                        <Setter Property="Foreground" Value="#A50034"/>
                                        <Setter Property="BorderBrush" Value="#A50034"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Border Grid.Row="1" Padding="60,40,60,60">
                <Grid>
                    <!-- Login Panel -->
                    <StackPanel Visibility="{Binding IsLoginView, Converter={StaticResource BoolToVisibilityConverter}}"
                                VerticalAlignment="Center">

                        <TextBlock Text="Welcome Back" FontSize="28" FontWeight="Bold"
                                   Foreground="#333333" Margin="0,0,0,10"/>
                        <TextBlock Text="Sign in to continue to VNB Messenger" FontSize="14"
                                   Foreground="#999999" Margin="0,0,0,40"/>

                        <!-- Email/Username -->
                        <TextBlock Text="EMAIL OR USERNAME" FontWeight="SemiBold"
                                   Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,24">
                            <TextBox Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                     VerticalContentAlignment="Center" Background="Transparent"/>
                        </Border>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD" FontWeight="SemiBold"
                                   Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                            <PasswordBox x:Name="txtLoginPassword"
                                         Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                         VerticalContentAlignment="Center" Background="Transparent"
                                         PasswordChanged="TxtLoginPassword_PasswordChanged"/>
                        </Border>

                        <!-- Error Message -->
                        <Border MinHeight="40" Margin="0,0,0,24"
                                Visibility="{Binding LoginError, Converter={StaticResource StringToVisibilityConverter}}">
                            <Border Background="#FFF0F0" BorderBrush="#A50034" BorderThickness="1"
                                    CornerRadius="4" Padding="16,12">
                                <TextBlock Text="{Binding LoginError}" Foreground="#A50034"
                                           FontSize="13" TextWrapping="Wrap"/>
                            </Border>
                        </Border>

                        <!-- Login Button -->
                        <Button Content="SIGN IN" Command="{Binding LoginCommand}"
                                Height="52" FontSize="14" FontWeight="Bold"
                                Background="#A50034" Foreground="White"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,20">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#A50034"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="20,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#8B0029"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#6E0021"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Loading -->
                        <TextBlock Text="⟳ Authenticating..." FontStyle="Italic"
                                   Foreground="#999999" FontSize="13" HorizontalAlignment="Center"
                                   Visibility="{Binding IsLoginLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                <!-- Register Panel -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsLoginView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel Margin="0,20,0,0">

                            <TextBlock Text="Create Account" FontSize="28" FontWeight="Bold"
                                       Foreground="#333333" Margin="0,0,0,10"/>
                            <TextBlock Text="Join VNB Messenger today" FontSize="14"
                                       Foreground="#999999" Margin="0,0,0,32"/>

                            <!-- Username -->
                            <TextBlock Text="USERNAME" FontWeight="SemiBold"
                                       Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                                <TextBox Text="{Binding RegisterUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                         VerticalContentAlignment="Center" Background="Transparent"/>
                            </Border>

                            <!-- Email -->
                            <TextBlock Text="EMAIL ADDRESS" FontWeight="SemiBold"
                                       Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                                <TextBox Text="{Binding RegisterEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                         VerticalContentAlignment="Center" Background="Transparent"/>
                            </Border>

                            <!-- Full Name -->
                            <TextBlock Text="FULL NAME" FontWeight="SemiBold"
                                       Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                                <TextBox Text="{Binding RegisterFullName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                         VerticalContentAlignment="Center" Background="Transparent"/>
                            </Border>

                            <!-- Phone Number -->
                            <TextBlock Text="PHONE NUMBER" FontWeight="SemiBold"
                                       Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                                <TextBox Text="{Binding RegisterPhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                         VerticalContentAlignment="Center" Background="Transparent"/>
                            </Border>

                            <!-- Password -->
                            <TextBlock Text="PASSWORD" FontWeight="SemiBold"
                                       Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20">
                                <PasswordBox x:Name="txtRegisterPassword"
                                             Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                             VerticalContentAlignment="Center" Background="Transparent"
                                             PasswordChanged="TxtRegisterPassword_PasswordChanged"/>
                            </Border>

                            <!-- Confirm Password -->
                            <TextBlock Text="CONFIRM PASSWORD" FontWeight="SemiBold"
                                       Foreground="#666666" FontSize="11" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                                <PasswordBox x:Name="txtRegisterConfirmPassword"
                                             Height="50" Padding="16,0" FontSize="15" BorderThickness="0"
                                             VerticalContentAlignment="Center" Background="Transparent"
                                             PasswordChanged="TxtRegisterConfirmPassword_PasswordChanged"/>
                            </Border>

                            <!-- Error Message -->
                            <Border MinHeight="40" Margin="0,0,0,24"
                                    Visibility="{Binding RegisterError, Converter={StaticResource StringToVisibilityConverter}}">
                                <Border Background="#FFF0F0" BorderBrush="#A50034" BorderThickness="1"
                                        CornerRadius="4" Padding="16,12">
                                    <TextBlock Text="{Binding RegisterError}" Foreground="#A50034"
                                               FontSize="13" TextWrapping="Wrap"/>
                                </Border>
                            </Border>

                            <!-- Register Button -->
                            <Button Content="CREATE ACCOUNT" Command="{Binding RegisterCommand}"
                                    Height="52" FontSize="14" FontWeight="Bold"
                                    Background="#A50034" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,20">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#A50034"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="20,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#8B0029"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#6E0021"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Loading -->
                            <TextBlock Text="⟳ Creating account..." FontStyle="Italic"
                                       Foreground="#999999" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,20"
                                       Visibility="{Binding IsRegisterLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
