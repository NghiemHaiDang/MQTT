<UserControl x:Class="ChatMQTT.Client.WPF.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:ChatMQTT.Client.WPF.Behaviors"
             Background="#FFFFFF">

    <Grid>
        <!-- Header với gradient giống Messenger -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0084FF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0" Command="{Binding BackCommand}"
                        Width="40" Height="40" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,15,0" ToolTip="Back to Topics">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FFFFFF" CornerRadius="20" Width="40" Height="40">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="←" FontSize="24" Foreground="#0084FF" FontWeight="Bold"/>
                </Button>

                <!-- Topic Info with Avatar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Avatar Circle -->
                    <Border Width="45" Height="45" CornerRadius="22.5" Background="#4CAF50" Margin="0,0,12,0">
                        <TextBlock Text="#" FontSize="24" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTopic}" FontSize="16" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock FontSize="12" Foreground="White" Opacity="0.8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Offline"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="Active now"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Connection Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Connect/Disconnect Button -->
                    <Button Command="{Binding ConnectCommand}"
                            Width="40" Height="40" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                            ToolTip="Connect">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF" CornerRadius="20" Width="40" Height="40">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="⚡" FontSize="20" Foreground="#0084FF"/>
                    </Button>

                    <Button Command="{Binding DisconnectCommand}"
                            Width="40" Height="40" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Disconnect">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF" CornerRadius="20" Width="40" Height="40">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="⏸" FontSize="20" Foreground="#F44336"/>
                    </Button>

                    <!-- Unsubscribe Button -->
                    <Button Command="{Binding UnsubscribeCommand}"
                            Width="40" Height="40" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"
                            ToolTip="Unsubscribe Topic">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#FFFFFF" CornerRadius="20" Width="40" Height="40">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="🔕" FontSize="20" Foreground="#FF9800"/>
                    </Button>
                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Column="4" Command="{Binding LogoutCommand}"
                        Width="40" Height="40" BorderThickness="0" Cursor="Hand"
                        ToolTip="Logout">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#FFFFFF" CornerRadius="20" Width="40" Height="40">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="⎋" FontSize="20" Foreground="#0084FF"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area: Users List (2) + Chat (8) -->
        <Grid Grid.Row="1" Background="#F0F2F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8*"/>
            </Grid.ColumnDefinitions>

            <!-- Users List Panel -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E6EB" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Users Header -->
                    <Border Grid.Row="0" Background="#F0F2F5" Padding="16,12" BorderBrush="#E4E6EB" BorderThickness="0,0,0,1">
                        <TextBlock Text="Users in Topic" FontSize="14" FontWeight="SemiBold" Foreground="#050505"/>
                    </Border>

                    <!-- Users List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ChatUsers}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="8,6" Margin="0,2" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0F2F5"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                    Background="#0084FF" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Username -->
                                            <TextBlock Grid.Column="1" Text="{Binding Username}" FontSize="13"
                                                       Foreground="#050505" VerticalAlignment="Center"/>

                                            <!-- Online Status -->
                                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#BCC0C4"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Chat Messages Area -->
            <ScrollViewer Grid.Column="1" x:Name="MessageScrollViewer" VerticalScrollBarVisibility="Auto"
                          Padding="20" Background="Transparent">
                <i:Interaction.Behaviors>
                    <behaviors:ScrollToTopBehavior Command="{Binding LoadMoreHistoryCommand}"/>
                </i:Interaction.Behaviors>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <!-- Layout cho tin nhắn của người khác (bên trái) -->
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar cho tin nhắn người khác -->
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                        Background="#E4E6EB" Margin="0,0,8,0" VerticalAlignment="Bottom">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding From, Converter={StaticResource FirstLetterConverter}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#65676B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Message Bubble -->
                                <StackPanel Grid.Column="1" MaxWidth="500">
                                    <!-- Tên người gửi (chỉ hiện với tin nhắn người khác) -->
                                    <TextBlock Text="{Binding From}" FontSize="11" Foreground="#65676B"
                                               Margin="12,0,0,2" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Message Content -->
                                    <Border CornerRadius="18" Padding="12,8" MaxWidth="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E4E6EB"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                        <Setter Property="Background" Value="#0084FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                   FontSize="14" LineHeight="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#050505"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Timestamp -->
                                    <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                               FontSize="11" Foreground="#65676B" Opacity="0.7"
                                               Margin="12,2,12,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOwnMessage}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Input Area -->
        <Border Grid.Row="2" Background="White" Padding="16" BorderBrush="#E4E6EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Attach Button -->
                <Button Grid.Column="0" Width="36" Height="36" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                        Command="{Binding ChangeTopicCommand}">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#E4E6EB">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D8DADF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="📎" FontSize="18" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <!-- Message Input -->
                <Border Grid.Column="1" Background="#F0F2F5" CornerRadius="20" Padding="12,0">
                    <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             FontSize="15" VerticalContentAlignment="Center"
                             Height="36">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground" Value="#050505"/>
                                <Setter Property="CaretBrush" Value="#0084FF"/>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <!-- Send Button -->
                <Button Grid.Column="2" Width="36" Height="36" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                        Command="{Binding SendMessageCommand}">
                    <Border Width="36" Height="36" CornerRadius="18" Background="#0084FF">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#0073E6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="➤" FontSize="18" Foreground="White"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
