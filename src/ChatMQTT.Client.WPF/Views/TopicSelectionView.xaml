<UserControl x:Class="ChatMQTT.Client.WPF.Views.TopicSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="#A50034" Height="80">
            <Grid Margin="40,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo and Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="50" Height="50" Margin="0,0,20,0">
                        <Canvas Width="100" Height="100">
                            <Ellipse Width="100" Height="100" Fill="White"/>
                            <Ellipse Canvas.Left="15" Canvas.Top="15" Width="70" Height="70" Fill="#A50034"/>
                            <Path Data="M 30,50 L 55,50 L 55,70 L 70,70" Stroke="White" StrokeThickness="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="58" Canvas.Top="58" Width="15" Height="15" Fill="White"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="VNB Messenger" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Username, StringFormat='Welcome, {0}'}"
                                   FontSize="13" Foreground="#FFB3C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Column="2" Command="{Binding LogoutCommand}"
                        Height="40" Padding="24,0" FontSize="13" FontWeight="SemiBold"
                        Background="Transparent" Foreground="White" Cursor="Hand"
                        BorderBrush="White" BorderThickness="2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#A50034"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⎋" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="LOGOUT" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="40,30,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title and Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Your Conversations" FontSize="28" FontWeight="Bold"
                           Foreground="#333333" VerticalAlignment="Center"/>

                <Button Content="🔄 REFRESH" Command="{Binding RefreshCommand}"
                        Height="44" Padding="20,0" FontSize="13" FontWeight="Bold"
                        HorizontalAlignment="Right" Cursor="Hand"
                        Background="#F8F8F8" Foreground="#666666" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#F8F8F8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8E8E8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Topics Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Topics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="350" Height="140" Background="White"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="8" Margin="0,0,20,20" Cursor="Hand"
                                    MouseLeftButtonUp="Border_MouseLeftButtonUp"
                                    Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#A50034"/>
                                                <Setter Property="Background" Value="#FFF8F9"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel Margin="20" VerticalAlignment="Center">
                                    <!-- Topic Name -->
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                               Foreground="#A50034" TextWrapping="Wrap" MaxHeight="50"
                                               Margin="0,0,0,8"/>

                                    <!-- Topic Description -->
                                    <TextBlock Text="{Binding Description}" FontSize="13"
                                               Foreground="#666666" TextWrapping="Wrap"
                                               MaxHeight="35" Margin="0,0,0,12"/>

                                    <!-- Status -->
                                    <Border Background="#F0F0F0" CornerRadius="3" Padding="8,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock FontSize="11" Foreground="#666666" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="INACTIVE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="1">
                                                            <Setter Property="Text" Value="ACTIVE"/>
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
