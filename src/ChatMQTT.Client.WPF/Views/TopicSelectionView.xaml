<UserControl x:Class="ChatMQTT.Client.WPF.Views.TopicSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid>
        <!-- Main Content -->
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2196F3" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Select a Topic" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding Username, StringFormat='Logged in as: {0}'}"
                                   FontSize="14" Foreground="White" Opacity="0.9" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Logout" Command="{Binding LogoutCommand}"
                            Width="100" Height="36" Background="#F44336" Foreground="White"
                            FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Topics List -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Available Topics" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#333" VerticalAlignment="Center"/>

                        <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}"
                                Width="100" Height="32" Background="#2196F3" Foreground="White"
                                FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="⟳ Loading topics..." FontSize="16" Foreground="Gray" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Topics ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Topics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                            CornerRadius="8" Padding="20" Margin="0,0,0,12" Cursor="Hand"
                                            MouseLeftButtonUp="Border_MouseLeftButtonUp"
                                            Tag="{Binding}">


                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F5F5F5"/>
                                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                                           Foreground="#2196F3" Margin="0,0,0,8"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#666"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Visibility="{Binding Description, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <TextBlock FontSize="11" Foreground="#999">
                                                    <Run Text="Created: "/>
                                                    <Run Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Info Button -->
                                                <Button Command="{Binding DataContext.ViewTopicDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="36" Height="36" Background="#E3F2FD"
                                                        BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                                                        ToolTip="View Details">
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="#E3F2FD">
                                                        <TextBlock Text="ℹ" FontSize="20" Foreground="#2196F3"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Button>

                                                <!-- Enter Button -->
                                                <Border Width="40" Height="40" CornerRadius="20"
                                                        Background="#E3F2FD" VerticalAlignment="Center">
                                                    <TextBlock Text="→" FontSize="24" Foreground="#2196F3"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Topic Detail Dialog Overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsDetailDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="550" Background="White" CornerRadius="12" Padding="30"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="Topic Details" FontSize="24" FontWeight="Bold" Foreground="#2196F3"/>
                        <Button Content="✕" Command="{Binding CloseDetailDialogCommand}"
                                Width="32" Height="32" Background="Transparent" Foreground="#666"
                                FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Content -->
                    <StackPanel Grid.Row="1">
                        <!-- Topic ID -->
                        <Border Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Topic ID" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TopicDetail.TopicId}" FontSize="13" Foreground="#333"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Topic Name -->
                        <Border Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Name" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TopicDetail.Name}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#2196F3"/>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <Border Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Description" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TopicDetail.Description}" FontSize="14" Foreground="#333"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- App ID -->
                        <Border Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="App ID" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding TopicDetail.AppId}" FontSize="13" Foreground="#333"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Created Info -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Created By" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding TopicDetail.CreatedBy}" FontSize="13" Foreground="#333"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Created At" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding TopicDetail.CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                               FontSize="13" Foreground="#333"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status -->
                        <Border Background="#F5F5F5" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Status" FontSize="11" Foreground="#999" Margin="0,0,0,5"/>
                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopicDetail.Status}" Value="0">
                                                    <Setter Property="Background" Value="#FFC107"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TopicDetail.Status}" Value="2">
                                                    <Setter Property="Background" Value="#F44336"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Active"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TopicDetail.Status}" Value="0">
                                                        <Setter Property="Text" Value="Pending"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TopicDetail.Status}" Value="2">
                                                        <Setter Property="Text" Value="Inactive"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Action Button -->
                        <Button Content="Enter Chat Room" Command="{Binding SelectTopicCommand}"
                                Height="44" FontSize="14" FontWeight="SemiBold"
                                Background="#2196F3" Foreground="White"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
