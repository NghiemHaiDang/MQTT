<Window x:Class="ChatMQTT.Client.WPF.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChatMQTT.Client.WPF.ViewModels"
        xmlns:views="clr-namespace:ChatMQTT.Client.WPF.Views"
        xmlns:local="clr-namespace:ChatMQTT.Client.WPF"
        Title="MQTT Chat Client" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- DataTemplates for ViewModels -->
        <DataTemplate x:Key="LoginViewTemplate" DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>

        <DataTemplate x:Key="TopicSelectionViewTemplate" DataType="{x:Type vm:TopicSelectionViewModel}">
            <views:TopicSelectionView/>
        </DataTemplate>

        <DataTemplate x:Key="ChatViewTemplate" DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView/>
        </DataTemplate>

        <!-- DataTemplate Selector -->
        <local:ViewModelDataTemplateSelector x:Key="ViewModelDataTemplateSelector"/>
    </Window.Resources>

    <!-- Content Presenter with DataTemplate -->
    <ContentControl Content="{Binding CurrentViewModel}"
                    ContentTemplateSelector="{StaticResource ViewModelDataTemplateSelector}"/>
</Window>
