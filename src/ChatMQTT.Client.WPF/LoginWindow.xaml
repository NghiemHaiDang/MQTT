<Window x:Class="ChatMQTT.Client.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MQTT Chat - Authentication" Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/TextBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Storyboard for fade in animation -->
            <Storyboard x:Key="FadeIn">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.3"/>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{StaticResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Close Button -->
            <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="30,20">
                    <TextBlock Text="MQTT Chat Client"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Connect and communicate securely"
                               FontSize="12"
                               Foreground="White"
                               Opacity="0.8"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Click="BtnClose_Click"
                        Style="{StaticResource IconButton}"
                        Foreground="White"
                        FontSize="20"
                        Width="40"
                        Height="40"
                        Margin="0,10,10,0"
                        VerticalAlignment="Top"/>
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="40,30,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab Buttons -->
                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundBrush}"
                        CornerRadius="8"
                        Padding="4"
                        Margin="0,0,0,30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnLoginTab"
                                Grid.Column="0"
                                Content="Login"
                                Click="BtnLoginTab_Click"
                                Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0"
                                Padding="0,12"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,2,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="btnRegisterTab"
                                Grid.Column="1"
                                Content="Register"
                                Click="BtnRegisterTab_Click"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Padding="0,12"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="2,0,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1">
                    <!-- Login Panel -->
                    <StackPanel x:Name="pnlLogin" Visibility="Visible">
                        <!-- Email/Username -->
                        <TextBlock Text="Email or Username"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtLoginEmail"
                                 Height="44"
                                 Padding="12,10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,20"/>

                        <!-- Password -->
                        <TextBlock Text="Password"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtLoginPassword"
                                     Height="44"
                                     Padding="12,10"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,12"
                                     KeyDown="TxtLoginPassword_KeyDown"/>

                        <!-- Error Message -->
                        <Border x:Name="borderLoginError"
                                Background="#FFEBEE"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtLoginError"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Login Button -->
                        <Button x:Name="btnLogin"
                                Content="Sign In"
                                Click="BtnLogin_Click"
                                Style="{StaticResource SuccessButton}"
                                Height="44"
                                FontSize="15"
                                Margin="0,0,0,20"/>

                        <!-- Loading Indicator -->
                        <StackPanel x:Name="pnlLoginLoading"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="⟳ Authenticating..."
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"/>
                        </StackPanel>

                        <!-- Footer -->
                        <TextBlock HorizontalAlignment="Center"
                                   Margin="0,20,0,0">
                            <Run Text="Don't have an account?"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="12"/>
                            <Hyperlink Click="BtnRegisterTab_Click"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       TextDecorations="None">
                                <Run Text="Sign up" FontWeight="SemiBold"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- Register Panel -->
                    <StackPanel x:Name="pnlRegister" Visibility="Collapsed">
                        <!-- Username -->
                        <TextBlock Text="Username"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtRegisterUsername"
                                 Height="44"
                                 Padding="12,10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,16"/>

                        <!-- Email -->
                        <TextBlock Text="Email Address"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="txtRegisterEmail"
                                 Height="44"
                                 Padding="12,10"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,16"/>

                        <!-- Password -->
                        <TextBlock Text="Password"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtRegisterPassword"
                                     Height="44"
                                     Padding="12,10"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,16"/>

                        <!-- Confirm Password -->
                        <TextBlock Text="Confirm Password"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,8"/>
                        <PasswordBox x:Name="txtRegisterConfirmPassword"
                                     Height="44"
                                     Padding="12,10"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,0,12"
                                     KeyDown="TxtRegisterConfirmPassword_KeyDown"/>

                        <!-- Error Message -->
                        <Border x:Name="borderRegisterError"
                                Background="#FFEBEE"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <TextBlock x:Name="txtRegisterError"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <!-- Register Button -->
                        <Button x:Name="btnRegister"
                                Content="Create Account"
                                Click="BtnRegister_Click"
                                Style="{StaticResource SecondaryButton}"
                                Height="44"
                                FontSize="15"
                                Margin="0,0,0,20"/>

                        <!-- Loading Indicator -->
                        <StackPanel x:Name="pnlRegisterLoading"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="⟳ Creating account..."
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"/>
                        </StackPanel>

                        <!-- Footer -->
                        <TextBlock HorizontalAlignment="Center"
                                   Margin="0,20,0,0">
                            <Run Text="Already have an account?"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="12"/>
                            <Hyperlink Click="BtnLoginTab_Click"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       TextDecorations="None">
                                <Run Text="Sign in" FontWeight="SemiBold"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
