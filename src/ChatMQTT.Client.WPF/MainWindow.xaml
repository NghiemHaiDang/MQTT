<Window x:Class="ChatMQTT.Client.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MQTT Chat Client" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <TextBlock x:Name="txtUserInfo" Text="Logged in as: User"
                           FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="MQTT Chat Application"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Connection Panel -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtHost" Grid.Column="1" Text="localhost"
                         Height="32" Padding="8" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtPort" Grid.Column="3" Text="1883" Width="80"
                         Height="32" Padding="8" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                <Button x:Name="btnConnect" Grid.Column="4" Content="Connect"
                        Width="120" Height="32" Background="#4CAF50" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnConnect_Click"/>
            </Grid>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Topic Info -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock x:Name="txtCurrentTopic" Text="Topic: chat/general"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0"/>
                    <TextBlock x:Name="txtConnectionStatus" Text="Disconnected"
                               FontSize="14" Foreground="Red"/>
                </StackPanel>

                <!-- Messages List -->
                <ScrollViewer x:Name="scrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
                    <ItemsControl x:Name="lstMessages">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                        CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding From}" FontWeight="Bold" FontSize="14"
                                                   Foreground="#2196F3" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Message}" FontSize="13"
                                                   TextWrapping="Wrap" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                   FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Status Bar -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="statusIndicator" Grid.Column="0"
                            Width="12" Height="12" CornerRadius="6"
                            Background="Red" Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatus" Grid.Column="1" Text="Disconnected"
                               FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="Client ID: " FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock x:Name="txtClientId" Text="-" FontSize="12" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <TextBlock x:Name="txtMessageCount" Text="0 messages" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Topic Change -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Change Topic:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtTopic" Grid.Column="1" Text="chat/general"
                         Height="32" Padding="8" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="btnChangeTopic" Grid.Column="2" Content="Change Topic"
                        Width="120" Height="32" Background="#FF9800" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnChangeTopic_Click"/>
            </Grid>
        </Border>

        <!-- Message Input -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtMessage" Grid.Column="0"
                         Height="40" Padding="10" FontSize="14"
                         VerticalContentAlignment="Center"
                         IsEnabled="False"
                         KeyDown="TxtMessage_KeyDown"/>

                <Button x:Name="btnSend" Grid.Column="1" Content="Send"
                        Width="100" Height="40" Margin="10,0,0,0"
                        Background="#2196F3" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        IsEnabled="False"
                        Click="BtnSend_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
